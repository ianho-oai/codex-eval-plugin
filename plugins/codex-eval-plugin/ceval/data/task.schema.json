{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "use_case",
    "difficulty",
    "difficulty_rationale",
    "benchmark_refs",
    "allowed_paths",
    "grader"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,100}$"
    },
    "use_case": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "difficulty_rationale": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_refs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "enum": [
          "deepswe",
          "swe-bench",
          "terminal-bench",
          "aider-polyglot",
          "swe-bench-pro",
          "swe-lancer",
          "featurebench",
          "gso",
          "testgeneval",
          "bigcodebench",
          "livecodebench",
          "evalplus",
          "swe-bench-multimodal"
        ]
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "grader": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,100}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rationale",
        "sources"
      ],
      "properties": {
        "kind": {
          "enum": [
            "benchmark-inspired",
            "original"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "example_id",
              "source_url",
              "adaptation"
            ],
            "properties": {
              "example_id": {
                "type": "string"
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "adaptation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "human_summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1000,
      "description": "Two or three plain-language sentences explaining the software development workflow and behavior tested, separate from execution instructions."
    }
  }
}
