{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation attempt",
  "type": "object",
  "required": [
    "cell_id",
    "task_id",
    "provider",
    "model",
    "effort",
    "repeat",
    "completion",
    "status",
    "valid",
    "simulation"
  ],
  "properties": {
    "completion": {
      "enum": [
        0,
        1
      ]
    },
    "provider": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "simulation": {
      "type": "boolean"
    },
    "latency_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "agent_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "grader_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cache_read_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cache_write_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "turns": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_lower_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_upper_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
