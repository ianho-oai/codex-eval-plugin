{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen evaluation suite",
  "type": "object",
  "required": [
    "execution",
    "limits",
    "matrix",
    "name",
    "pricing",
    "repeats",
    "schema_version",
    "seed",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "execution": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "matrix": {
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "pricing": {
      "type": "string"
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "seed": {
      "type": "integer"
    },
    "tasks": {
      "type": "array"
    },
    "purpose": {
      "enum": [
        "customer",
        "smoke"
      ]
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Schema 2 customer suites require all three difficulty tiers and provenance for every declared workflow. Schema 1 remains readable for existing runs. Runtime validation additionally checks hashes, source links, paths, and native settings.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "purpose",
          "workflows"
        ]
      }
    }
  ]
}
