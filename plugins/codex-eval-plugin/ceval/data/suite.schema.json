{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen evaluation suite",
  "type": "object",
  "required": [
    "execution",
    "limits",
    "matrix",
    "name",
    "pricing",
    "repeats",
    "schema_version",
    "seed",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "execution": {
      "type": "object",
      "properties": {
        "copilot_account": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
          "description": "Explicit native github.com Copilot login. Must match the active saved account. Uses OS credential storage instead of token environment variables."
        },
        "copilot_bin": {
          "type": "string",
          "minLength": 1
        },
        "copilot_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "agent_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "description": "Null means no timeout."
        },
        "grader_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "description": "Null means no timeout."
        },
        "copilot_max_ai_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 30,
          "description": "Required for Copilot. Null means no credit limit; otherwise a soft per-attempt AI-credit cap that can overshoot."
        }
      }
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "efforts"
        ],
        "properties": {
          "provider": {
            "enum": [
              "codex",
              "claude",
              "copilot"
            ]
          },
          "model": {
            "type": "string"
          },
          "efforts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "name": {
      "type": "string"
    },
    "pricing": {
      "type": "string"
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "seed": {
      "type": "integer"
    },
    "tasks": {
      "type": "array"
    },
    "purpose": {
      "enum": [
        "customer",
        "smoke"
      ]
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "difficulties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "description": "Explicit requested scope; defaults to all three tiers."
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ids"
      ],
      "properties": {
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Schema 2 customer suites require provenance and coverage for every declared workflow; difficulties defaults to all three tiers and can explicitly narrow the requested scope. Schema 1 remains readable. Runtime validation additionally checks hashes, source links, paths, and native settings.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "purpose",
          "workflows"
        ]
      }
    }
  ]
}
